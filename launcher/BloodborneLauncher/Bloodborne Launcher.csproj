<Project Sdk="Microsoft.NET.Sdk">
  <!-- Recovered from Lantern Engine's Bloodborne Launcher 0.9.33 (Awakenchan, GPL) with ILSpy:
       the published sources stop at 0.9.29. The window layouts are the release's compiled BAML. -->
  <PropertyGroup>
    <AssemblyName>Bloodborne Launcher</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0168;CS0219;CS0162</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="**\*.baml" />
    <None Remove="assets\backdrop.jpg" />
    <Resource Include="app.baml" />
    <Resource Include="mainwindow.baml" />
    <Resource Include="themes\styles.baml" />
    <Resource Include="themes\glass.baml" />
    <Resource Include="themes\charcoal.baml" />
    <Resource Include="assets\backdrop.jpg" />
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>
